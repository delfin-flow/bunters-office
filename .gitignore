# store/ is the person's package: its own git repository, never part of this one
# (charters/package.md). The workspace keeps its upstream remote, so it must stay clean
# of personal data — that is exactly what this line protects.
/store/

# Scratch, caches and generated output live ONLY here (charters/footprint.md).
# Nothing of ours may be written outside this repository.
build/
.tmp/
.cache/
*.zip
!templates/pack/*.zip
.DS_Store
